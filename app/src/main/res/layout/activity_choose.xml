<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg1">

    <TextView
        android:id="@+id/t1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mode_select_title"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/mode_title"
        android:layout_gravity="center"
        android:layout_marginTop="140dp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/button1"
        android:layout_width="220dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="@string/mode_simple"
        android:textColor="@color/mode_button_text"
        android:layout_gravity="center"
        android:textStyle="bold"
        android:textSize="24sp"
        android:background="@drawable/bg_mode_button" />

    <Button
        android:id="@+id/button2"
        android:layout_width="220dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="@string/mode_normal"
        android:textColor="@color/mode_button_text"
        android:layout_gravity="center"
        android:textStyle="bold"
        android:textSize="24sp"
        android:background="@drawable/bg_mode_button" />

    <Button
        android:id="@+id/button3"
        android:layout_width="220dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="@string/mode_hard"
        android:textColor="@color/mode_button_text"
        android:layout_gravity="center"
        android:textStyle="bold"
        android:textSize="24sp"
        android:background="@drawable/bg_mode_button" />

    <Button
        android:id="@+id/button4"
        android:layout_width="220dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="@string/mode_timed"
        android:textColor="@color/mode_button_timed"
        android:layout_gravity="center"
        android:textStyle="bold"
        android:textSize="24sp"
        android:background="@drawable/bg_mode_button_timed" />

</LinearLayout>
